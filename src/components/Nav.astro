---
import { site } from '../data/site';
---

<header class="nav-wrap" id="top">
  <nav class="container nav" aria-label="Main">
    <a class="brand" href="/">{site.name}</a>
    <ul>
      <li><a href="/#work">Work</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href="/ryanjrusson_resume.pdf" target="_blank" rel="noopener">Resume</a></li>
    </ul>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--band) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #34608c;
  }

  .nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 0.65rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    color: var(--paper);
  }

  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  ul a {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--paper);
    border-bottom: 1px solid transparent;
  }

  ul a:hover {
    border-bottom-color: #6fae9c;
  }

  /* the site-wide green outline is too dark against the navy band */
  .nav-wrap a:focus-visible {
    outline-color: #6fae9c;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-wrap {
      transition: transform 200ms ease;
    }

    :global(html.js) .nav-wrap[data-hidden] {
      transform: translateY(-100%);
    }
  }
</style>

<script>
  // Hide on scroll-down, reveal on scroll-up.
  const wrap = document.querySelector<HTMLElement>('.nav-wrap');
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (wrap) {
        if (y > lastY && y > 120) wrap.setAttribute('data-hidden', '');
        else wrap.removeAttribute('data-hidden');
      }
      lastY = y;
    },
    { passive: true }
  );
</script>
