---
import { Picture } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const number = String(project.order).padStart(2, '0');
---

<article class="card" id={project.id}>
  <header class="card-head">
    <span class="label number">{number}</span>
    <h3>{project.title}</h3>
    <span class="label context">{project.context}</span>
    {project.hasDemo && <span class="label demo-badge">interactive</span>}
  </header>

  {
    project.image && (
      <figure class="media">
        <Picture
          src={project.image.src}
          alt={project.image.alt}
          formats={['avif', 'webp']}
          widths={[640, 833, 1280]}
          sizes="(max-width: 1080px) 100vw, 1016px"
        />
        {project.image.note && (
          <figcaption class="label media-note">{project.image.note}</figcaption>
        )}
      </figure>
    )
  }

  <div class="body">
    {project.summary.map((para) => <p>{para}</p>)}
  </div>

  <ul class="tags" aria-label="Technologies">
    {project.tags.map((tag) => <li class="label">{tag}</li>)}
  </ul>

  {
    (project.links?.length || project.deepDive) && (
      <ul class="links">
        {project.deepDive && (
          <li>
            <a href={project.deepDive}>Read the write-up / Try it</a>
          </li>
        )}
        {project.links?.map((link) => {
          const newTab = link.href.startsWith('http') || link.href.endsWith('.pdf');
          return (
            <li>
              <a
                href={link.href}
                target={newTab ? '_blank' : undefined}
                rel={newTab ? 'noopener' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</article>

<style>
  /* The card surface itself (.card) is styled in global.css. */

  .card-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .number {
    color: var(--muted);
  }

  h3 {
    font-size: var(--step-2);
  }

  .context {
    margin-left: auto;
  }

  .demo-badge {
    color: var(--matched-text);
    border: 1px solid var(--matched);
    border-radius: 2px;
    padding: 0.05rem 0.35rem;
  }

  /* --- screenshot --- */

  .media {
    margin-top: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .media-note {
    display: block;
    border-top: 1px solid var(--rule);
    padding: 0.4rem 0.75rem;
    text-transform: none;
    letter-spacing: 0;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* --- body, tags, links --- */

  .body {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.9rem;
  }

  .tags {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0;
  }

  .links {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    padding: 0;
  }

  .links a {
    font-weight: 500;
  }
</style>
