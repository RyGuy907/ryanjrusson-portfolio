---
/* The repeatable deep-dive recipe (§12 rule 3): server-rendered prose and
   static media first, optional demo island mounted on top. Every /work/*
   page uses this layout — never a one-off page. */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    context?: string;
    /** Anchor of a demo island on the page, e.g. "#wordle-demo". */
    demoHref?: string;
    /** Where "← Selected work" returns to; defaults to the section top. */
    backHref?: string;
  };
}

const { frontmatter } = Astro.props;
const backHref = frontmatter.backHref ?? '/#work';
---

<Base title={`${frontmatter.title} — Ryan Russon`} description={frontmatter.description}>
  <Nav />
  <main>
    <article class="container deep-dive">
      <header>
        <p class="top-links">
          <a href={backHref} class="back">← Selected work</a>
          {frontmatter.demoHref && (
            <a href={frontmatter.demoHref} class="back jump">Jump to the demo ↓</a>
          )}
        </p>
        <h1>{frontmatter.title}</h1>
        {frontmatter.context && <p class="label context">{frontmatter.context}</p>}
      </header>
      <div class="prose">
        <slot />
      </div>
      <p class="bottom-link"><a href={backHref} class="back">← Selected work</a></p>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .deep-dive {
    padding-block: clamp(2.5rem, 7vh, 4.5rem) 0;
  }

  .back {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--muted);
  }

  .back:hover {
    color: var(--matched);
  }

  .top-links {
    display: flex;
    gap: 2rem;
    max-width: none;
  }

  .jump {
    color: var(--matched-text);
  }

  .bottom-link {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: clamp(var(--step-3), 6vw, var(--step-4));
  }

  .context {
    margin-top: 0.75rem;
  }

  .prose {
    margin-top: 2.5rem;
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
  }

  .prose :global(h3) {
    font-size: var(--step-1);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(p) {
    margin-bottom: 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    max-width: var(--measure);
    padding-left: 1.4rem;
    margin-bottom: 1rem;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: color-mix(in srgb, var(--rule) 30%, transparent);
    border-radius: 2px;
    padding: 0.1em 0.3em;
  }

  .prose :global(table) {
    border-collapse: collapse;
    margin-bottom: 1rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--rule);
    padding: 0.35rem 1.1rem 0.35rem 0;
    text-align: left;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--muted);
  }
</style>
